digraph VerifiedNonBlocking {
  rankdir=TB;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="Verified non-blocking before reporting anything";
  labelloc="t";
  fontsize=16;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, penwidth=1.5];
  edge [color="#556070", fontcolor="#ffa93a", fontname="Helvetica"];

  onDisk [fillcolor="#0f2a20", color="#39ffb0", label="utils.py on disk: file_signature\ngenuinely present, confirmed by direct read"];
  freshVer [fillcolor="#0f2a20", color="#39ffb0", label="fresh hermes --version: exit 0"];
  freshZ [fillcolor="#0f2a20", color="#39ffb0", label="fresh hermes -z one-shot: exit 0,\ncorrect output"];
  gwStatus [fillcolor="#0f2a20", color="#39ffb0", label="hermes gateway status:\nno gateway running (CLI-only usage) —\n\"restart your gateway\" advice moot here"];
  cfgIntact [fillcolor="#0f2a20", color="#39ffb0", label="This session's hardening survived the\nupdate's config migration untouched:\ndocker backend, checkpoints, deny rules"];
  sandboxOk [fillcolor="#0f2a20", color="#39ffb0", label="Sandbox re-verified post-update:\ndot -V still works inside the container"];
  retryClean [fillcolor="#0f2a20", color="#39ffb0", penwidth=2.5, label="Second hermes update run:\ncompleted cleanly, no error"];
  conclusion [fillcolor="#152a3a", color="#39d0ff", penwidth=2.5,
              label="Reported upstream as a real, low-severity,\nnon-reproducing residual gap in an existing\nmitigation — not a live crisis"];

  onDisk -> freshVer -> freshZ -> gwStatus -> cfgIntact -> sandboxOk -> retryClean -> conclusion;
}
