digraph DenyRules {
  rankdir=TB;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="approvals.deny: unconditional, even under --yolo";
  labelloc="t";
  fontsize=18;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, penwidth=1.5];
  edge [color="#556070", fontcolor="#ffa93a", fontname="Helvetica"];

  cmd [fillcolor="#1a1f26", color="#556070", label="Any terminal command"];
  deny [shape=diamond, fillcolor="#152a3a", color="#39d0ff", label="Matches an approvals.deny glob?\n(\"rm -rf */\", \"rm -rf ~/Documents/*\")"];
  blocked [fillcolor="#3a0d0d", color="#ff4d4d", fontcolor="#ffdada", penwidth=2.5,
           label="BLOCKED — no exceptions.\nNot yolo. Not mode:off.\nNot an isolated container either."];
  yolo [shape=diamond, fillcolor="#152a3a", color="#39d0ff", label="--yolo / approvals.mode: off ?"];
  skip [fillcolor="#1a1f26", color="#556070", label="Approval layer skipped"];
  smart2 [fillcolor="#152a3a", color="#39d0ff", label="smart-approval / manual prompt\n(the layer that failed before)"];
  run [fillcolor="#0f2a20", color="#39ffb0", label="Command executes"];

  cmd -> deny;
  deny -> blocked [label="yes"];
  deny -> yolo [label="no"];
  yolo -> skip [label="yes"];
  yolo -> smart2 [label="no"];
  skip -> run;
  smart2 -> run [label="approved"];
}
