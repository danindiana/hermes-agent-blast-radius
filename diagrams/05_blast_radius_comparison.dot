digraph BlastRadius {
  rankdir=LR;
  bgcolor="#0a0e12";
  fontname="Helvetica";
  fontcolor="#dfe6ee";
  label="Blast radius: what a repeat rm -rf can reach";
  labelloc="t";
  fontsize=22;
  node [style=filled, fontname="Helvetica", fontcolor="#dfe6ee", shape=box, penwidth=1.5];
  edge [color="#556070", style=invis];

  subgraph cluster_before {
    label="BEFORE";
    fontcolor="#ff4d4d";
    color="#ff4d4d";
    style=dashed;
    bgcolor="#150d0d";
    b1 [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="git repo (src/docs/tests/vendor)"];
    b2 [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="arxiv PDF + audio papers"];
    b3 [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="4 prior session folders"];
    b4 [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="agent_purchasing_research/"];
    b5 [fillcolor="#4a0808", color="#ff4d4d", fontcolor="#fff0f0", label="23 of 24 files written that morning"];
    b1 -> b2 -> b3 -> b4 -> b5;
  }

  subgraph cluster_after {
    label="AFTER";
    fontcolor="#39ffb0";
    color="#39ffb0";
    style=dashed;
    bgcolor="#0d1f18";
    a1 [fillcolor="#0f2a20", color="#39ffb0", label="hermes-sessions/ contents\n(bind-mounted /workspace only)"];
    a2 [fillcolor="#152a3a", color="#39d0ff", label="…recoverable anyway via\n/rollback (checkpoints)"];
    a3 [fillcolor="#1a1f26", color="#556070", label="everything else in $HOME:\nunreachable — not mounted"];
    a1 -> a2 -> a3;
  }
}
